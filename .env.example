# Copy to .env and fill in real values. Never commit .env.

# ---- Runtime ---------------------------------------------------------------
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8081
LOG_LEVEL_APP=DEBUG

# ---- Database --------------------------------------------------------------
# The LMS control-plane database. It stores platform.tenants. When tenant mode
# is enabled, request data is routed to that tenant's dedicated cert schema.
DB_URL=jdbc:postgresql://aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
DB_USERNAME=postgres.<project-ref>
DB_PASSWORD=
DB_SCHEMA=cert
DB_POOL_SIZE=3

# ---- JWT -------------------------------------------------------------------
# MUST be identical to JWT_SECRET in LMS-BackEnd.
JWT_SECRET=
JWT_ISSUER=lms-backend

# ---- Service-to-service key ------------------------------------------------
# MUST match SERVICE_KEY_SECRET in LMS-BackEnd.
SERVICE_KEY_SECRET=

# ---- LMS-BackEnd connection ------------------------------------------------
LMS_BACKEND_URL=http://localhost:8080
LMS_BACKEND_TIMEOUT_MS=5000

# ---- Cloudflare R2 ---------------------------------------------------------
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_ACCESS_KEY=
R2_SECRET_KEY=
# Reuse the LMS Cloudflare R2 bucket. Certificate objects are isolated below
# Certificates/{tenantId}/ and never overlap the existing courses/ prefix.
R2_BUCKET=buildhub-lms
R2_PUBLIC_URL=https://pub-<hash>.r2.dev

# ---- Mail ------------------------------------------------------------------
MAIL_ENABLED=false
MAIL_FROM=no-reply@lms.local
MAIL_FROM_NAME=GradusMind Certificates
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=

# ---- App -------------------------------------------------------------------
# Used in PDF verify links and email footers.
PUBLIC_BASE_URL=http://localhost:8081

# ---- Tenant runtime --------------------------------------------------------
# Must match the LMS-BackEnd configuration. Enable only after the platform UI
# and all tenant routing changes are deployed.
TENANCY_ENABLED=false
TENANT_RESOLUTION_REQUIRED=false
TENANT_HEADER=X-Tenant-Slug
TENANT_CREDENTIAL_ENCRYPTION_KEY=
